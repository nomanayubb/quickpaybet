DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://quickpaybet:quickpaybet@localhost:5432/quickpaybet
REDIS_URL=redis://localhost:6379/0
CORS_ALLOW_ALL_ORIGINS=True

# Only set this to True once TLS is actually terminated in front of Django
# (e.g. nginx has a real certificate configured). If there's no HTTPS in
# front of the app yet, leave this False even in production, or every
# request will be redirected to an HTTPS endpoint that doesn't exist.
SECURE_SSL_REDIRECT=False

# 'redis' (default, matches Docker/production) or 'locmem' if you're running
# manage.py/tests directly on a machine with no local Redis server. Celery
# still needs a real Redis broker regardless of this setting.
CACHE_BACKEND=redis

# Email backend – choose console for development or SMTP for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=QuickPayBet <no-reply@yourdomain.com>

# Odds provider: mock | theoddsapi | parlayapi
ODDS_PROVIDER=mock
ODDS_API_KEY=
ODDS_API_URL=
ODDS_SPORT_KEY=soccer_epl

# ParlayAPI (parlay-api.com) - only used when ODDS_PROVIDER=parlayapi.
# PARLAY_BOOKMAKER is which bookmaker's price to prefer (falls back to any
# other available bookmaker for a match that one doesn't cover). Betfair is
# not a data source on this API - do not set this to "betfair".
PARLAY_API_KEY=
PARLAY_API_URL=https://parlay-api.com/v1
PARLAY_BOOKMAKER=pinnacle

# Payment provider: mock | nowpayments
PAYMENT_PROVIDER=mock
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=http://YOUR_DOMAIN/api/payments/webhook/

# Casino/iGaming aggregator provider: mock | softapi | waija
# SoftAPI (branded igamingapis.live, migrating to world-casino-api.com -
# the old domain shuts off 2026-09-10). SOFTAPI_SECRET must be exactly 32
# characters (AES-256 key, used for AES-256-ECB+PKCS7 launch/callback
# encryption). The server's public IP must be whitelisted in the SoftAPI
# Client Panel -> Settings before launch calls will succeed.
CASINO_PROVIDER=mock
SOFTAPI_API_URL=https://world-casino-api.com/api/v1
SOFTAPI_TOKEN=
SOFTAPI_SECRET=

# Waija (branded front for the underlying "slotsgateway" product - see
# https://documentation.waija.com/). A true seamless-wallet provider: no
# balance is ever handed over at launch, every bet/win is applied live via
# WAIJA_SALTKEY-signed GET callbacks to /api/casino/waija/callback/.
# WAIJA_API_URL is the account-specific base URL from Waija's own Settings
# page - no public default. WAIJA_PLAYER_SECRET is used only locally to
# derive a stable per-user Waija sub-account password (never sent to
# Waija as a literal env value, and never stored in our own DB).
WAIJA_API_LOGIN=
WAIJA_API_PASSWORD=
WAIJA_API_URL=
WAIJA_SALTKEY=
WAIJA_PLAYER_SECRET=

# USD->PKR live rate (apps.wallet.tasks.refresh_usd_pkr_rate, hourly via
# Celery beat) for every PKR-currency user's deposits/withdrawals/balance -
# see apps.wallet.models.FxRateConfig. Pulled from the free
# fawazahmed0/currency-api (static JSON on the jsdelivr/Cloudflare Pages
# CDNs, no key/account/subscription required - see
# apps/wallet/management/commands/refresh_fx_rate.py). No env var needed.
# If the fetch ever fails, the last known/admin-set rate on FxRateConfig
# (Django admin) is used instead - never blocks deposits.

# Disaster-recovery database backups (backup_database/restore_database
# management commands). Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this key somewhere OTHER than this file/the repo (e.g. a password
# manager) - losing it makes every existing backup permanently unreadable;
# leaking it exposes every user's and every wallet's data, since encrypted
# backups are only ever as safe as this one key.
BACKUP_ENCRYPTION_KEY=
