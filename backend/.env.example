DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://quickpaybet:quickpaybet@localhost:5432/quickpaybet
REDIS_URL=redis://localhost:6379/0
CORS_ALLOW_ALL_ORIGINS=True

# Only set this to True once TLS is actually terminated in front of Django
# (e.g. nginx has a real certificate configured). If there's no HTTPS in
# front of the app yet, leave this False even in production, or every
# request will be redirected to an HTTPS endpoint that doesn't exist.
SECURE_SSL_REDIRECT=False

# 'redis' (default, matches Docker/production) or 'locmem' if you're running
# manage.py/tests directly on a machine with no local Redis server. Celery
# still needs a real Redis broker regardless of this setting.
CACHE_BACKEND=redis

# Email backend – choose console for development or SMTP for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=QuickPayBet <no-reply@yourdomain.com>

# Odds provider: mock | theoddsapi
ODDS_PROVIDER=mock
ODDS_API_KEY=
ODDS_API_URL=
ODDS_SPORT_KEY=soccer_epl

# Payment provider: mock | nowpayments
PAYMENT_PROVIDER=mock
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=http://YOUR_DOMAIN/api/payments/webhook/
